# Postgres (em produção, Supabase região São Paulo: use a connection string do pooler)
DATABASE_URL=postgres://acolhe:acolhe@localhost:5432/acolhe
# Endereço público do app, usado nos links dos e-mails
APP_URL=http://localhost:3000
# Envio de e-mail pelo Resend. Sem chave, os e-mails vão para o console e para a tabela email_dev.
RESEND_API_KEY=
EMAIL_REMETENTE="Acolhimento Conectado <nao-responda@seu-dominio.org>"
# Segredo exigido pela rota /api/cron (Vercel Cron envia como Bearer)
CRON_SECRET=troque-este-valor
# "off" desliga a consulta de CNPJ na BrasilAPI (útil em testes)
CONSULTA_CNPJ=
# E-mails das pessoas da curadoria (MPE/AL), separados por vírgula. Aplicado a cada deploy.
CURADORES_INICIAIS=
